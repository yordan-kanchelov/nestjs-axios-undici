{
  // Editor, ts-jest and `npm run typecheck` (src + tests). The build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "node20",
    "types": ["node", "jest"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "strict": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./lib",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "tests"]
}
