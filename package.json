{
  "name": "nestjs-axios-undici",
  "version": "0.6.0",
  "description": "Drop-in @nestjs/axios replacement built on Undici: the same HttpModule/HttpService API and axios-compatible responses, errors and interceptors, with much lower latency.",
  "homepage": "https://yordan-kanchelov.github.io/nestjs-axios-undici/",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve:website": "npx docsify-cli serve .",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint",
    "test": "jest && npm run test:examples",
    "test:unit": "jest src/",
    "test:e2e": "jest tests/",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:examples": "npm run build && node scripts/run-examples.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/testing": "^11.2.6",
    "@opentelemetry/api": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "axios": "^1.10.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nock": "^14.0.5",
    "prettier": "^3.9.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "undici": "^7.30.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0",
    "undici": "^7.0.0 || ^8.0.0"
  },
  "contributors": [
    {
      "name": "Hebert Cisco <hebertcisco@outlook.com>",
      "url": "https://github.com/hebertcisco",
      "author": true
    },
    {
      "name": "binsee",
      "url": "https://github.com/binsee",
      "author": false
    },
    {
      "name": "shevchenkonik",
      "url": "https://github.com/shevchenkonik",
      "author": false
    },
    {
      "name": "favelado-web",
      "url": "https://github.com/favelado-web",
      "author": false
    }
  ],
  "files": [
    "lib",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "nestjs",
    "nest",
    "axios",
    "@nestjs/axios",
    "undici",
    "http",
    "http-client",
    "httpmodule",
    "httpservice",
    "drop-in",
    "interceptors",
    "fast"
  ],
  "author": {
    "name": "Yordan Kanchelov",
    "url": "https://github.com/yordan-kanchelov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordan-kanchelov/nestjs-axios-undici.git"
  },
  "bugs": {
    "url": "https://github.com/yordan-kanchelov/nestjs-axios-undici/issues"
  },
  "dependencies": {
    "http-cookie-agent": "^8.0.0",
    "tough-cookie": "^5.1.2 || ^6.0.0"
  }
}
