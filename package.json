{
  "name": "nestjs-axios-undici",
  "version": "0.6.0",
  "description": "Drop-in @nestjs/axios replacement built on Undici: the same HttpModule/HttpService API and axios-compatible responses, errors and interceptors, with much lower latency.",
  "homepage": "https://yordan-kanchelov.github.io/nestjs-axios-undici/",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=22",
    "npm": ">=9"
  },
  "scripts": {
    "serve:website": "npx docsify-cli serve .",
    "build": "rimraf -rf lib && tsc -p tsconfig.json",
    "format": "prettier --write \"{src,tests,examples}/**/*.ts\"",
    "lint": "eslint src --ext .js,.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint",
    "test": "jest && npm run test:examples",
    "test:unit": "jest src/",
    "test:e2e": "jest tests/",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:examples": "npm run build && node scripts/run-examples.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@types/jest": "29.5.14",
    "@types/nock": "^10.0.3",
    "@types/node": "22.10.7",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "axios": "^1.10.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "29.7.0",
    "nock": "^14.0.5",
    "prettier": "3.4.2",
    "reflect-metadata": "0.2.2",
    "rimraf": "5.0.10",
    "rxjs": "7.8.1",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "undici": "^7.8.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^6.0.0 || ^7.0.0",
    "undici": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "contributors": [
    {
      "name": "Hebert Cisco <hebertcisco@outlook.com>",
      "url": "https://github.com/hebertcisco",
      "author": true
    },
    {
      "name": "binsee",
      "url": "https://github.com/binsee",
      "author": false
    },
    {
      "name": "shevchenkonik",
      "url": "https://github.com/shevchenkonik",
      "author": false
    },
    {
      "name": "favelado-web",
      "url": "https://github.com/favelado-web",
      "author": false
    }
  ],
  "files": [
    "*.d.ts",
    "index.js",
    "lib",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "nestjs",
    "nest",
    "axios",
    "@nestjs/axios",
    "undici",
    "http",
    "http-client",
    "httpmodule",
    "httpservice",
    "drop-in",
    "interceptors",
    "fast"
  ],
  "author": {
    "name": "Yordan Kanchelov",
    "url": "https://github.com/yordan-kanchelov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordan-kanchelov/nestjs-axios-undici.git"
  },
  "bugs": {
    "url": "https://github.com/yordan-kanchelov/nestjs-axios-undici/issues"
  },
  "dependencies": {
    "http-cookie-agent": "^7.0.1",
    "tough-cookie": "^5.1.2"
  }
}
